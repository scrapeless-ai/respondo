include LICENSE
include pyproject.toml
include README.md
include README.pypi.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include RELEASING.md
include requirements-release.in
include requirements-release.txt
include .coveragerc
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py *.html *.json *.xml *.csv
recursive-include assets *.svg *.png *.md
recursive-include examples *.py *.html *.json *.xml
recursive-include src *.py
exclude CLAUDE.md
recursive-exclude src demo_*.py
recursive-exclude * __pycache__
recursive-exclude * *.pyc
